"""coresmith -- CLI client for the coresmithd daemon.

Replaces the old ``run_pipeline.py`` headless driver. Cron-fired agents
(and humans) use this to start the daemon, inspect run state, and resume
the pipeline after each interrupt.

The CLI auto-discovers the daemon for a given project_root by reading
``<project_root>/.coresmith/daemon.json``. Specify the project root via
``--project-root`` or ``CORESMITH_PROJECT_ROOT`` env var.

Usage examples::

    coresmith daemon start --project-root /tmp/myrun
    coresmith run start --blocks-file blocks.yaml
    coresmith state
    coresmith resume --action approve
    coresmith daemon stop

Common decision actions for ``resume``:
    approve     -- accept a uarch_spec_review / uarch_integration_review
    retry       -- retry a block that failed (debug_classifier interrupts)
    skip        -- skip a block whose attempts are exhausted
    abort       -- stop the run
    feedback    -- send feedback text back to the agent (architecture)
    fix_rtl     -- you edited RTL on disk; re-run the failed stage
    fix_tb      -- you edited TB on disk; re-run the failed stage
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional

# Re-exec into the repo venv if we are not already running under it, so
# httpx + the orchestrator deps resolve without forcing every caller to
# `source venv/bin/activate` first. We detect "already in venv" by sys.prefix.
_REPO_ROOT = Path(__file__).resolve().parent.parent
_VENV_DIR = _REPO_ROOT / "venv"
_VENV_PY = _VENV_DIR / "bin" / "python"
if (
    _VENV_PY.exists()
    and not Path(sys.prefix).resolve().samefile(_VENV_DIR.resolve())
):
    os.execv(str(_VENV_PY), [str(_VENV_PY), str(Path(__file__).resolve()), *sys.argv[1:]])

import httpx

# The run's persisted env (``.coresmith/env``) loader, shared with the daemon so
# both apply the SAME semantics (the persisted file wins over ambient values).
# Stdlib-only, so importing it costs nothing; a CLI copied away from the repo
# still drives a remote daemon, hence the guard rather than a hard import.
try:
    if str(_REPO_ROOT) not in sys.path:
        sys.path.insert(0, str(_REPO_ROOT))
    from orchestrator import run_env as _run_env
except ImportError:  # pragma: no cover -- CLI without the engine package
    _run_env = None


# ---------------------------------------------------------------------------
# Daemon discovery
# ---------------------------------------------------------------------------

def _project_root(arg: Optional[str]) -> Path:
    pr = arg or os.environ.get("CORESMITH_PROJECT_ROOT")
    if not pr:
        sys.exit(
            "error: pass --project-root or set CORESMITH_PROJECT_ROOT.\n"
            "       the daemon is per-run (per project_root)."
        )
    return Path(pr).resolve()


def _daemon_file(project_root: Path) -> Path:
    return project_root / ".coresmith" / "daemon.json"


def _daemon_info(project_root: Path) -> dict:
    df = _daemon_file(project_root)
    if not df.exists():
        sys.exit(
            f"error: no daemon for {project_root}\n"
            f"       run: coresmith daemon start --project-root {project_root}"
        )
    return json.loads(df.read_text())


def _daemon_url(project_root: Path) -> str:
    info = _daemon_info(project_root)
    return f"http://127.0.0.1:{info['port']}"


def _alive(pid: int) -> bool:
    try:
        pid = int(pid)
        if pid <= 0:
            return False
        os.kill(pid, 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------

def _get(project_root: Path, path: str) -> dict:
    url = _daemon_url(project_root) + path
    try:
        r = httpx.get(url, timeout=30)
    except httpx.HTTPError as e:
        sys.exit(f"error: GET {url} -- {e}")
    if r.status_code >= 400:
        sys.exit(f"error: GET {url} -> {r.status_code}\n{r.text}")
    return r.json()


def _post(project_root: Path, path: str, body: dict) -> dict:
    url = _daemon_url(project_root) + path
    try:
        r = httpx.post(url, json=body, timeout=60)
    except httpx.HTTPError as e:
        sys.exit(f"error: POST {url} -- {e}")
    if r.status_code >= 400:
        sys.exit(f"error: POST {url} -> {r.status_code}\n{r.text}")
    return r.json()


# Exit codes of the machine-readable verbs (the harness convention):
# 0 ok, 1 a failed verdict, 2 a refused / invalid request, 3 infrastructure.
EXIT_REFUSED, EXIT_INFRA = 2, 3


class _DaemonError(Exception):
    def __init__(self, code: int, payload: dict):
        super().__init__(payload.get("message") or payload.get("error") or "daemon error")
        self.code = code
        self.payload = payload


def _request(project_root: Path, method: str, path: str, body: dict | None = None) -> dict:
    """One daemon request that raises ``_DaemonError`` with the JSON body (or
    the text) instead of exiting: the ``build`` verbs translate it to a
    machine-readable document and an exit code."""
    try:
        url = _daemon_url(project_root) + path
    except SystemExit as exc:
        raise _DaemonError(EXIT_INFRA, {"error": "DAEMON_UNAVAILABLE", "message": str(exc)}) from exc
    try:
        r = httpx.post(url, json=body or {}, timeout=60) if method == "POST" else httpx.get(url, timeout=30)
    except httpx.HTTPError as e:
        raise _DaemonError(EXIT_INFRA, {"error": "DAEMON_UNREACHABLE", "message": f"{method} {url} -- {e}"}) from e
    try:
        payload = r.json()
    except ValueError:
        # a daemon that answers something other than JSON -- on any status --
        # is not a daemon this client can trust: infrastructure, never success
        raise _DaemonError(EXIT_INFRA, {"error": "DAEMON_BAD_RESPONSE", "http_status": r.status_code,
                                        "message": f"{method} {url} returned a non-JSON body: {r.text[:500]!r}"}) from None
    if r.status_code >= 500:
        raise _DaemonError(EXIT_INFRA, {"http_status": r.status_code, **_as_error(payload)})
    if r.status_code >= 400:
        raise _DaemonError(EXIT_REFUSED, {"http_status": r.status_code, **_as_error(payload)})
    return payload


def _as_error(payload) -> dict:
    """FastAPI's ``{"detail": ...}`` and the daemon's ``{"error": ...}`` as one shape."""
    if not isinstance(payload, dict):
        return {"error": "DAEMON_ERROR", "message": str(payload)}
    if "error" in payload:
        return payload
    detail = payload.get("detail")
    if isinstance(detail, dict):
        return {"error": str(detail.get("error") or "DAEMON_ERROR"), **detail}
    return {"error": "DAEMON_ERROR", "message": str(detail if detail is not None else payload)}


def _emit_daemon(args, call):
    """Run ``call()`` (a daemon request) and print its document: JSON with
    ``--json`` (refusals and failures included), else the human form. Exit
    2 for a refused / invalid request, 3 for an unreachable daemon or an
    infrastructure failure."""
    want_json = bool(getattr(args, "json", False))
    try:
        payload = call()
    except _DaemonError as exc:
        if want_json:
            print(json.dumps(exc.payload, indent=2, default=str))
        else:
            msg = exc.payload.get("message") or ""
            print(f"error: {exc.payload.get('error', 'DAEMON_ERROR')}" + (f": {msg}" if msg else ""), file=sys.stderr)
            for b in exc.payload.get("blocked_by") or []:
                print(f"  - {b.get('code')}: {b.get('text', '')} {b.get('ids') or ''}", file=sys.stderr)
            if exc.payload.get("hint"):
                print(f"  hint: {exc.payload['hint']}", file=sys.stderr)
        sys.exit(exc.code)
    print(json.dumps(payload, indent=2, default=str))
    return payload


# ---------------------------------------------------------------------------
# Subcommands: daemon
# ---------------------------------------------------------------------------

def _daemon_start(args):
    project_root = _project_root(args.project_root)
    project_root.mkdir(parents=True, exist_ok=True)
    (project_root / ".coresmith").mkdir(exist_ok=True)

    df = _daemon_file(project_root)
    if df.exists():
        try:
            info = json.loads(df.read_text())
            if _alive(info.get("pid", 0)):
                print(f"daemon already running pid={info['pid']} port={info['port']}")
                return
        except Exception:
            pass
        df.unlink(missing_ok=True)

    env = os.environ.copy()
    env["CORESMITH_PROJECT_ROOT"] = str(project_root)

    # Load the sticky env vars the operator persisted at run-start time. Lets a
    # daemon restart pick up CORESMITH_LLM_PROVIDER, model overrides,
    # CORESMITH_SKIP_SYNTH, CORESMITH_REFERENCE_ENTRY, etc. without re-sourcing
    # launch.sh each time. Format: one "KEY=VALUE" per line, "#" lines ignored.
    #
    # The file is the run's FROZEN config, so for the keys it contains it is
    # AUTHORITATIVE: it ASSIGNS rather than setdefault()s. Under setdefault a
    # stale value already exported in the daemon-launching shell won silently --
    # observed live with a persisted CORESMITH_REFERENCE_ENTRY=oracle while the
    # composition gate ran the ambient `run`. Every ambient value we replace is
    # printed so the operator sees the swap instead of inferring it from gate
    # behaviour.
    env_file = project_root / ".coresmith" / "env"
    persisted: dict = {}
    if _run_env is not None:
        persisted = _run_env.load_persisted_env(project_root)
        notice = _run_env.format_override_notice(
            _run_env.apply_persisted_env(project_root, env)
        )
        if notice:
            print(notice)
    elif env_file.exists():
        sys.exit(
            f"error: {env_file} exists but orchestrator.run_env is not "
            f"importable from {_REPO_ROOT} -- refusing to launch a daemon with "
            "the run's persisted env unapplied"
        )

    # PATH is special: the persisted file records the launch PATH under
    # CORESMITH_SAVED_PATH, never as a bare PATH= line (assigning a whole PATH
    # would clobber the caller's), so applying the file above does not bring
    # toolchain dirs from the run's LAUNCH env back -- they were silently lost
    # on a bare-shell restart, observed as cocotb picking
    # system Verilator 5.020 over oss-cad-suite's 5.051 and failing its >=5.036
    # requirement. The launch PATH is persisted under CORESMITH_SAVED_PATH (see
    # the persist block below); on restart, PREPEND any of its entries missing
    # from the current PATH (prepend, not append, so the launch toolchain wins
    # over same-named system tools -- exactly what sourcing run_env.sh did).
    # The venv/repo-bin injections below still land in front of everything.
    _saved_path = env.get("CORESMITH_SAVED_PATH", "").strip()
    if _saved_path:
        _cur_parts = [p for p in env.get("PATH", "").split(os.pathsep) if p]
        _missing = [p for p in _saved_path.split(os.pathsep)
                    if p and p not in _cur_parts]
        if _missing:
            env["PATH"] = os.pathsep.join(_missing + _cur_parts)
            print(f"restored {len(_missing)} launch-env PATH entr"
                  f"{'y' if len(_missing) == 1 else 'ies'} from "
                  f"CORESMITH_SAVED_PATH")

    # Auto-persist the run's WORKER SELECTORS so a later restart is self-
    # sufficient. Footgun this closes: a `daemon start` that did NOT re-source
    # the run's launch env instantiated the WRONG LLM (e.g. ClaudeLLM instead of
    # the pinned codex/gpt-5.6-sol worker) -- silently swapping the model mid-
    # run. We snapshot the effective non-secret provider/model selectors from
    # the ambient env into .coresmith/env when present-and-not-already-recorded,
    # so every subsequent restart reconstructs the same worker without the
    # operator having to re-source anything. SECRETS (api keys / tokens) are
    # deliberately NOT persisted -- they stay in the ambient env / keyring.
    _persist_keys = (
        "CORESMITH_LLM_PROVIDER", "CORESMITH_CODEX_MODEL", "CORESMITH_MODEL",
        "CODEX_CLI_PATH", "CODEX_HOME",
        "CORESMITH_CODEX_REASONING_EFFORT", "CORESMITH_CODEX_REASONING_EFFORT_ARCH",
    )
    try:
        _recorded = set(persisted)
        _to_add = []
        for k in _persist_keys:
            v = os.environ.get(k)
            if v and k not in _recorded:
                if any(tok in k for tok in ("KEY", "TOKEN", "SECRET", "PASSWORD")):
                    continue  # never persist secrets
                _to_add.append(f"{k}={v}")
        # Snapshot the launch PATH once (first properly-sourced start) so later
        # bare-shell restarts can restore the run's toolchain dirs (see the
        # CORESMITH_SAVED_PATH merge above). Recorded once, never overwritten.
        if "CORESMITH_SAVED_PATH" not in _recorded and os.environ.get("PATH"):
            _to_add.append(f"CORESMITH_SAVED_PATH={os.environ['PATH']}")
        if _to_add:
            env_file.parent.mkdir(parents=True, exist_ok=True)
            with open(env_file, "a", encoding="utf-8") as _ef:
                if _recorded:
                    _ef.write("\n")
                _ef.write("# auto-persisted worker selectors (restart-safe)\n")
                _ef.write("\n".join(_to_add) + "\n")
            print(f"persisted worker selectors to {env_file}: "
                  f"{[a.split('=',1)[0] for a in _to_add]}")
    except Exception as e:  # noqa: BLE001 -- persistence is best-effort
        print(f"note: worker-selector persist skipped: {e}")

    # The CLI role (architect / worker / watchdog) scopes the CALLING shell,
    # never the engine: a daemon started from a watchdog shell must not hand
    # CORESMITH_ROLE=watchdog to its synthesis agent or cluster workers (they
    # would be ROLE_FORBIDDEN). CORESMITH_DAEMON_KEEP_ROLE=1 keeps it (old
    # behaviour).
    if os.environ.get("CORESMITH_DAEMON_KEEP_ROLE", "").strip().lower() not in {"1", "true", "yes", "on"}:
        _dropped = [k for k in ("CORESMITH_ROLE", "CORESMITH_ACTOR") if env.pop(k, None) is not None]
        if _dropped:
            print(f"note: {', '.join(_dropped)} not passed to the daemon (a CLI role scopes a shell, "
                  "not the engine)")

    log_path = project_root / ".coresmith" / "daemon.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)

    # Spawn detached. The daemon writes daemon.json on startup; poll for it.
    repo_root = Path(__file__).resolve().parent.parent
    python = repo_root / "venv" / "bin" / "python"
    if not python.exists():
        python = Path(sys.executable)

    # Inject the repo venv onto PATH so subprocesses spawned by the daemon
    # (cocotb-config, verilator wrappers, etc.) resolve to the same toolchain
    # the venv was provisioned with, regardless of the caller's PATH.
    venv_bin = repo_root / "venv" / "bin"
    if venv_bin.is_dir():
        env["PATH"] = f"{venv_bin}:{env.get('PATH', '')}"
        env["VIRTUAL_ENV"] = str(repo_root / "venv")

    # B3: prepend the repo bin/ so every agent the daemon spawns resolves the
    # `coresmith` verify-as-tool CLI on PATH (agents inherit the daemon env).
    repo_bin = repo_root / "bin"
    if repo_bin.is_dir():
        env["PATH"] = f"{repo_bin}:{env.get('PATH', '')}"

    # Defect 1 (rung1): codex runs agent commands via `/bin/bash -lc`, where
    # /etc/profile unconditionally reassigns PATH and drops the repo bin/ prefix
    # injected above (RTL agents hit `coresmith verify ... -> exit 127`). Export
    # an ABSOLUTE handle to the CLI so agents can invoke `"$CORESMITH_CLI"
    # <subcommand>` (falling back to plain `coresmith` if unset) regardless of
    # what /etc/profile does to PATH. Agents inherit this daemon env.
    cli_path = repo_bin / "coresmith"
    if cli_path.exists():
        env["CORESMITH_CLI"] = str(cli_path)
        # Belt-and-suspenders: also refresh a /usr/local/bin/coresmith symlink so
        # a bare `coresmith` resolves even in a profile-reset shell. Best-effort;
        # never fatal (no-op if the dir is unwritable or holds a real file).
        try:
            sys.path.insert(0, str(repo_root))
            from orchestrator.harness.env import ensure_cli_symlink
            if ensure_cli_symlink(cli_path) is None:
                print(
                    "note: /usr/local/bin/coresmith symlink not refreshed "
                    "(agents use $CORESMITH_CLI or the repo bin/ on PATH)"
                )
        except Exception as e:  # noqa: BLE001 -- symlink is optional
            print(f"note: coresmith symlink refresh skipped: {e}")

    # cocotb 2.x requires PYTHONHOME so the Verilator-embedded Python
    # interpreter can find pygpi (a separate package introduced in
    # cocotb 2.0). Without it, every sim invocation fails with
    # ``ModuleNotFoundError: No module named 'pygpi'`` even though the
    # module is on disk next to cocotb itself. We auto-detect the required
    # value -- from the interpreter we are about to SPAWN, not from the one
    # running this script, since they are usually different (system python
    # here, repo venv python there) -- and inject it. The operator may
    # override by setting PYTHONHOME explicitly in the environment or in
    # .coresmith/env. resolve_pythonhome() returns None rather than a prefix
    # with no stdlib: injecting one of those kills the daemon at startup
    # ("No module named 'encodings'"), which is worse than not setting it.
    if "PYTHONHOME" not in env:
        try:
            sys.path.insert(0, str(repo_root))
            from orchestrator.harness.env import resolve_pythonhome
            pythonhome = resolve_pythonhome(python)
            if pythonhome:
                env["PYTHONHOME"] = pythonhome
            else:
                print(
                    "note: PYTHONHOME not injected -- no interpreter prefix with "
                    "a stdlib found. cocotb sims may fail with 'No module named "
                    "pygpi'; set PYTHONHOME explicitly if they do."
                )
        except Exception as e:  # noqa: BLE001 -- auto-detect is best-effort
            print(f"note: PYTHONHOME auto-detect skipped: {e}")

    with open(log_path, "ab") as logf:
        proc = subprocess.Popen(
            [str(python), "-m", "orchestrator.daemon.server", "--port", str(args.port or 0)],
            cwd=str(repo_root),
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=logf,
            stderr=logf,
            start_new_session=True,
        )

    for _ in range(50):
        if df.exists():
            info = json.loads(df.read_text())
            print(f"daemon started pid={info['pid']} port={info['port']}")
            print(f"log: {log_path}")
            return
        if proc.poll() is not None:
            sys.exit(
                f"error: daemon exited with code {proc.returncode}\n"
                f"see {log_path}"
            )
        time.sleep(0.2)

    sys.exit(
        f"error: daemon did not write {df} within 10s -- check {log_path}"
    )


def _daemon_stop(args):
    project_root = _project_root(args.project_root)
    df = _daemon_file(project_root)
    if not df.exists():
        print(f"no daemon for {project_root}")
        return
    info = json.loads(df.read_text())
    pid = info.get("pid", 0)
    if pid and _alive(pid):
        try:
            os.kill(pid, 15)  # SIGTERM
            print(f"sent SIGTERM to pid={pid}")
        except OSError as e:
            print(f"warning: could not signal pid={pid}: {e}")
    else:
        df.unlink(missing_ok=True)
        print("stale daemon file removed")


def _daemon_status(args):
    project_root = _project_root(args.project_root)
    df = _daemon_file(project_root)
    if not df.exists():
        print(f"no daemon for {project_root}")
        return
    info = json.loads(df.read_text())
    alive = _alive(info.get("pid", 0))
    print(json.dumps({**info, "alive": alive}, indent=2))


# ---------------------------------------------------------------------------
# Subcommands: run
# ---------------------------------------------------------------------------

def _supervisor(args):
    root = _project_root(args.project_root)
    if args.supervisor_cmd in ("check", "retry"):
        # The only external recovery responsibility: a dead daemon cannot wake itself.
        info_file = root / ".coresmith" / "daemon.json"
        info = json.loads(info_file.read_text()) if info_file.exists() else {}
        if not _alive(info.get("pid", 0)):
            import time
            attempts_file = root / ".coresmith" / "supervisor-daemon-restarts.json"
            attempts_file.parent.mkdir(parents=True, exist_ok=True)
            attempts = json.loads(attempts_file.read_text()) if attempts_file.exists() else []
            attempts = [t for t in attempts if time.time() - t < 3600]
            if len(attempts) >= 3:
                sys.exit("supervisor blocked: daemon restart limit reached (3 starts/hour)")
            attempts.append(time.time())
            attempts_file.write_text(json.dumps(attempts))
            _daemon_start(argparse.Namespace(project_root=str(root), port=0))
        result = _post(root, "/supervisor/" + args.supervisor_cmd, {})
    else:
        result = _get(root, "/supervisor/status")
    print(json.dumps(result, indent=2))


def _run_start(args):
    project_root = _project_root(args.project_root)
    body = {
        "max_attempts": args.max_attempts,
        "target_clock_mhz": args.target_clock_mhz,
        "blocks_file": args.blocks_file or "",
        "force": bool(getattr(args, "force", False)),
    }
    response = _post(project_root, "/run/start", body)
    for w in response.get("warnings", []) or []:
        print(f"warning: {w}", file=sys.stderr)
    print(json.dumps(response, indent=2))


def _run_pause(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(_post(project_root, "/run/pause", {}), indent=2))


def _run_restart_node(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(
        _post(project_root, "/run/restart-node",
              {"node": args.node,
               "refresh_sidecars": bool(getattr(args, "refresh_sidecars", False))}),
        indent=2))


def _run_revise_blocks(args):
    project_root = _project_root(args.project_root)
    blocks = [b for b in args.blocks.replace(",", " ").split() if b]
    print(json.dumps(
        _post(project_root, "/run/revise-blocks",
              {"blocks": blocks, "feedback": args.feedback or ""}),
        indent=2))


def _run_state(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(_get(project_root, "/run/state"), indent=2))


def _run_resume(args):
    project_root = _project_root(args.project_root)
    body = {
        "action": args.action,
        "feedback": args.feedback or "",
        "rtl_fix_description": args.rtl_fix_description or "",
        "rationale": args.rationale or "",
        "block_actions": json.loads(args.block_actions) if args.block_actions else None,
        "actor": args.actor or os.environ.get("CORESMITH_ROLE") or "cli",
    }
    if args.interrupt_id:
        body["interrupt_id"] = args.interrupt_id
    if args.affected_blocks:
        body["affected_blocks"] = [b.strip() for b in args.affected_blocks.split(",") if b.strip()]
    print(json.dumps(_post(project_root, "/run/resume", body), indent=2))


def _run_logs(args):
    project_root = _project_root(args.project_root)
    path = project_root / ".coresmith" / "pipeline_events.jsonl"
    if not path.exists():
        sys.exit(f"no events at {path}")
    n = args.tail
    lines = path.read_text().splitlines()[-n:]
    for line in lines:
        print(line)


# ---------------------------------------------------------------------------
# Subcommands: architecture (PRD -> SAD -> FRD -> ERS -> block_diagram ->
# constraint check). Produces the ers_spec.json + block_specs.json that the
# pipeline phase consumes.
# ---------------------------------------------------------------------------

def _arch_start(args):
    project_root = _project_root(args.project_root)
    body = {
        "requirements_file": args.requirements_file or "",
        "requirements": args.requirements or "",
        "target_clock_mhz": args.target_clock_mhz,
        "pdk_config_path": args.pdk_config_path or "",
        "max_rounds": args.max_rounds,
    }
    print(json.dumps(_post(project_root, "/architecture/start", body), indent=2))


def _arch_state(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(_get(project_root, "/architecture/state"), indent=2))


def _arch_resume(args):
    project_root = _project_root(args.project_root)
    body = {
        "action": args.action,
        "feedback": args.feedback or "",
        "rationale": args.rationale or "",
    }
    print(json.dumps(_post(project_root, "/architecture/resume", body), indent=2))


def _arch_pause(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(_post(project_root, "/architecture/pause", {}), indent=2))


# ---------------------------------------------------------------------------
# backend (flat synthesis -> chip_top gate-sim [-> P&R/DRC/LVS])
# ---------------------------------------------------------------------------

def _backend_start(args):
    project_root = _project_root(args.project_root)
    body = {
        "max_attempts": args.max_attempts,
        "target_clock_mhz": args.target_clock_mhz,
        "full": bool(args.full),
    }
    print(json.dumps(_post(project_root, "/backend/start", body), indent=2))


def _backend_state(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(_get(project_root, "/backend/state"), indent=2))


def _backend_resume(args):
    project_root = _project_root(args.project_root)
    body = {
        "action": args.action,
        "feedback": args.feedback or "",
        "rationale": args.rationale or "",
        "actor": args.actor or os.environ.get("CORESMITH_ROLE") or "cli",
    }
    if args.interrupt_id:
        body["interrupt_id"] = args.interrupt_id
    print(json.dumps(_post(project_root, "/backend/resume", body), indent=2))


def _backend_pause(args):
    project_root = _project_root(args.project_root)
    print(json.dumps(_post(project_root, "/backend/pause", {}), indent=2))


# ---------------------------------------------------------------------------
# build: one recorded module build through the existing block subgraph
# (daemon lifecycle verbs) + read-only queries of the builds ledger (in-process)
# ---------------------------------------------------------------------------

def _build_module(args):
    project_root = _project_root(args.project_root)
    body = {
        "module": args.module,
        "seed_rtl": args.seed_rtl or "",
        "max_attempts": args.max_attempts,
        "target_clock_mhz": args.target_clock_mhz,
        "uarch_feedback": args.uarch_feedback or "",
    }
    _emit_daemon(args, lambda: _request(project_root, "POST", "/build/module", body))


def _build_targets(args):
    """``build targets <module>``: the FRD target allocation a build of the
    module would bind (read-only, in-process), with every refusal it would
    raise. Measurability is re-checked by the daemon at ``build module``."""
    from orchestrator.module_build import target_refusal
    from orchestrator.state_store import module_targets as MT
    root, db = _build_db(args)
    if args.module not in {b["name"] for b in db.block_specs()}:
        _build_refuse(args, "UNKNOWN_MODULE", f"{args.module!r} is not a registered block")
    alloc = MT.allocation(db, root, args.module)
    refusal = target_refusal(db, root, args.module)
    payload = {"module": args.module, **{k: alloc[k] for k in ("targets", "functional", "deferred", "unverified",
                                                                "acceptance", "frd_revision", "digest", "problems",
                                                                "advisories")},
               "refusal": refusal.to_json() if refusal else None,
               "ok": not alloc["problems"] and refusal is None, "brief": MT.brief(alloc)}
    lines = [f"targets of {args.module}: digest {str(alloc['digest'] or '-')[:16]}"
             + (f"  FRD rev {alloc['frd_revision'].get('version')}" if alloc.get("frd_revision") else "")]
    for t in alloc["targets"]:
        bound = " ".join(x for x in ((f">={t['bound_min']:g}" if t["bound_min"] is not None else ""),
                                     (f"<={t['bound_max']:g}" if t["bound_max"] is not None else "")) if x)
        how = "; ".join((f"cocotb {b['path']}::{b['entry']}" + (f" {json.dumps(b['args'])}" if b.get("args") else "")
                         if b["kind"] == "cocotb" else f"eda {b['measure']}") for b in t["bindings"])
        lines.append(f"  {'REQUIRED' if t['required'] else 'advisory':<9} {t['id']:<16} {t['metric']} {bound} "
                     f"{t['unit']}  <- {how}")
    for f in alloc["functional"]:
        lines.append(f"  {'REQUIRED' if f['required'] else 'advisory':<9} {f['id']:<16} functional: "
                     + ", ".join(b["entry"] for b in f["bindings"]))
    if alloc["deferred"]:
        lines.append("  deferred to chip scope: " + ", ".join(alloc["deferred"]))
    if alloc["unverified"]:
        lines.append("  must-have without a verifier (blocks exit will require one): " + ", ".join(alloc["unverified"]))
    acc = alloc.get("acceptance")
    if acc:
        for f in MT.acceptance_files(acc):
            lines.append(f"  acceptance testbench: {f['path']} ({(f.get('sha256') or '-')[:12]}) runs as {f['module']}")
        lines.append(f"  supplemental tests (coverage closure only) go in {acc['supplemental']}")
    else:
        lines.append("  acceptance testbench: none (the worker owns the testbench)")
    for p in alloc["problems"]:
        lines.append(f"  REFUSED {p['code']} {p['where']}: {p['text']}")
    if refusal:
        lines.append(f"  REFUSED {refusal.code}: {refusal.text}")
        lines += [f"    {b['text']}" for b in refusal.blockers]
    for p in alloc["advisories"]:
        lines.append(f"  advisory {p['code']} {p['where']}: {p['text']}")
    _emit_build(args, payload, lines)
    if not payload["ok"]:
        sys.exit(EXIT_REFUSED)


def _build_status(args):
    project_root = _project_root(args.project_root)
    path = "/build/state" + (f"?build_id={args.build_id}" if args.build_id else "")
    _emit_daemon(args, lambda: _request(project_root, "GET", path))


def _build_resume(args):
    project_root = _project_root(args.project_root)
    body = {
        "build_id": args.build_id,
        "action": args.action,
        "feedback": args.feedback or "",
        "rtl_fix_description": args.rtl_fix_description or "",
        "rationale": args.rationale or "",
        "actor": args.actor or os.environ.get("CORESMITH_ROLE") or "cli",
    }
    if args.interrupt_id:
        body["interrupt_id"] = args.interrupt_id
    _emit_daemon(args, lambda: _request(project_root, "POST", "/build/resume", body))


def _build_pause(args):
    project_root = _project_root(args.project_root)
    _emit_daemon(args, lambda: _request(project_root, "POST", "/build/pause", {}))


def _build_abort(args):
    project_root = _project_root(args.project_root)
    body = {"build_id": args.build_id, "reason": args.reason or "",
            "actor": args.actor or os.environ.get("CORESMITH_ROLE") or "cli"}
    _emit_daemon(args, lambda: _request(project_root, "POST", "/build/abort", body))


def _build_db(args):
    from orchestrator.state_store.project_db import open_project
    root = _project_root(args.project_root)
    os.environ["CORESMITH_PROJECT_ROOT"] = str(root)
    return root, open_project(root)


def _emit_build(args, payload, human_lines):
    if getattr(args, "json", False):
        print(json.dumps(payload, indent=2, default=str))
    else:
        print("\n".join(human_lines))


def _build_refuse(args, code: str, message: str, exit_code: int = EXIT_REFUSED):
    """A refused read-only build verb: a JSON document with ``--json``, a
    stderr line otherwise; exit 2 (invalid input) by default."""
    if getattr(args, "json", False):
        print(json.dumps({"error": code, "message": message}, indent=2))
    else:
        print(f"error: {code}: {message}", file=sys.stderr)
    sys.exit(exit_code)


def _build_list(args):
    from orchestrator.state_store import builds as B
    _root, db = _build_db(args)
    rows = B.builds_for(db, args.module or None, limit=args.limit)
    lines = [f"{r['id']:<44} {r['module']:<20} {r['status']:<18} {r['entry']:<14} "
             f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(r['requested_at']))}" for r in rows] or ["(no recorded builds)"]
    _emit_build(args, {"builds": rows}, lines)


def _build_show(args):
    from orchestrator.state_store import builds as B
    root, db = _build_db(args)
    row = B.get_build(db, args.build_id)
    if row is None:
        _build_refuse(args, "UNKNOWN_BUILD", f"no build {args.build_id}")
    payload = {"build": row, "evidence": B.evidence_for_build(root, args.build_id),
               "current": B.current_build_status(db, root, row["module"]) if row["status"] == "completed" else None}
    lines = [f"build {row['id']}: module {row['module']} status {row['status']} entry {row['entry']} thread {row['thread_id']}",
             f"  inputs digest {((row.get('inputs') or {}).get('digest') or '-')}",
             f"  worker {json.dumps((row.get('worker') or {}).get('provider'))} / {json.dumps((row.get('worker') or {}).get('model'))}",
             "  rows: " + ", ".join(f"{k} {len(v)}" for k, v in payload["evidence"].items())]
    if row.get("error"):
        lines.append(f"  error: {row['error'][:300]}")
    if payload["current"] is not None:
        lines.append("  current pass: " + ("ok" if payload["current"]["ok"] else "; ".join(payload["current"]["reasons"])))
    from orchestrator.module_build import candidate_summaries, targets_summary
    payload["targets"] = targets_summary(row.get("inputs") or {})
    payload["candidates"] = candidate_summaries(db, row["id"])
    tsum = payload["targets"]
    lines.append(f"  targets: required {tsum['required'] or '-'} advisory {tsum['advisory'] or '-'} functional "
                 f"{tsum['functional'] or '-'}; acceptance {tsum['acceptance_tb'] or '-'}")
    for c in payload["candidates"]:
        vals = ", ".join(f"{k}={v['value'] if v['value'] is not None else '-'}{(' ' + v['unit']) if v['unit'] else ''}"
                         f"({v['status']})" for k, v in c["targets"].items())
        lines.append(f"  candidate #{c['id']} attempt {c['attempt']}"
                     + f": {c['outcome']}" + (f" [{vals}]" if vals else ""))
    _emit_build(args, payload, lines)


def _build_compare(args):
    from orchestrator.state_store import builds as B
    root, db = _build_db(args)
    try:
        res = B.compare(db, root, args.build_a, args.build_b)
    except ValueError as exc:
        _build_refuse(args, "UNKNOWN_BUILD", str(exc))
    lines = [f"{args.build_a} vs {args.build_b} (same module: {res['same_module']})"]
    for side in ("a", "b"):
        m = res[side]
        lines.append(f"  [{side}] {m['module']} {m['status']} inputs {str(m['inputs_digest'])[:12]} "
                     f"ppa {json.dumps(m['ppa'])} dv {json.dumps(m['dv'])} coverage {json.dumps(m['coverage'])}"
                     + (f" targets {json.dumps(m['targets'])}" if m.get("targets") else ""))
    lines.append("  input differences: " + ("; ".join(res["input_differences"]) or "none"))
    _emit_build(args, res, lines)


def _build_lineage(args):
    from orchestrator.state_store import builds as B
    root, db = _build_db(args)
    res = B.lineage(db, root, args.module or None)
    lines = [f"intended workflow: {res['intended_workflow']}"]
    for name, m in res["modules"].items():
        pub = m["published"]
        lines.append(f"  {name}: intended_workflow={m['intended_workflow']} published build={pub['build_id']} "
                     f"ok={pub['ok']} checkpoints={pub['graph_checkpoints_present']} builds={len(m['builds'])}"
                     + (f" reasons: {'; '.join(pub['reasons'])}" if pub["reasons"] else ""))
    _emit_build(args, res, lines)


# ---------------------------------------------------------------------------
# Main parser
# ---------------------------------------------------------------------------

def _add_project_root(p: argparse.ArgumentParser):
    p.add_argument("--project-root", help="overrides $CORESMITH_PROJECT_ROOT")


def main():
    # A-Fix 1: seed profile flag defaults (strict by default) so the CLI and any
    # daemon it spawns share the same gate posture. Best-effort: the CLI still
    # works if the engine package isn't importable in this interpreter.
    try:
        import sys as _sys
        _sys.path.insert(0, str(_REPO_ROOT))
        from orchestrator.profile import apply as _apply_profile
        _apply_profile()
    except Exception:
        pass

    ap = argparse.ArgumentParser(prog="coresmith")
    sub = ap.add_subparsers(dest="cmd", required=True)

    # daemon ...
    pd = sub.add_parser("daemon", help="manage the coresmithd daemon")
    psub = pd.add_subparsers(dest="daemon_cmd", required=True)
    p1 = psub.add_parser("start", help="start the daemon")
    _add_project_root(p1)
    p1.add_argument("--port", type=int, default=0, help="bind port (0 = pick free)")
    p1.set_defaults(func=_daemon_start)
    p2 = psub.add_parser("stop", help="stop the daemon (SIGTERM)")
    _add_project_root(p2)
    p2.set_defaults(func=_daemon_stop)
    p3 = psub.add_parser("status", help="print daemon.json + liveness")
    _add_project_root(p3)
    p3.set_defaults(func=_daemon_status)

    ps = sub.add_parser("supervisor", help="daemon-owned lifecycle supervision")
    ss = ps.add_subparsers(dest="supervisor_cmd", required=True)
    for verb in ("status", "check", "retry"):
        sp = ss.add_parser(verb)
        _add_project_root(sp)
        sp.set_defaults(func=_supervisor)

    # run start
    pr1 = sub.add_parser("run", help="run lifecycle")
    rsub = pr1.add_subparsers(dest="run_cmd", required=True)
    r1 = rsub.add_parser("start", help="start a fresh pipeline run")
    _add_project_root(r1)
    r1.add_argument("--blocks-file", default="")
    r1.add_argument("--max-attempts", type=int, default=5)
    r1.add_argument("--target-clock-mhz", type=float, default=None,
                    help="default: inputs/task.yaml target_clock_mhz, else 50")
    r1.add_argument("--force", action="store_true",
                    help="discard an existing run and start fresh (default: "
                         "refuse if a run already exists -- resume it instead)")
    r1.set_defaults(func=_run_start)
    r2 = rsub.add_parser("pause", help="cancel the current task")
    _add_project_root(r2)
    r2.set_defaults(func=_run_pause)
    r3 = rsub.add_parser("restart-node",
                         help="re-run from a specific node (reuses on-disk "
                              "RTL; targeted alternative to `run start --force`)")
    _add_project_root(r3)
    r3.add_argument("node", help="node to restart from, e.g. integration_check, "
                                 "integration_dv, validation_dv, process_block")
    r3.add_argument("--refresh-sidecars", action="store_true",
                    help="re-sync intact-RTL blocks' contract sidecars to live "
                         "first, so the integration staleness preflight does "
                         "not force a mass-regen of already-passing blocks")
    r3.set_defaults(func=_run_restart_node)
    r4 = rsub.add_parser("revise-blocks",
                         help="re-enter named published blocks with feedback "
                              "(targeted revise plan; other blocks are not redone)")
    _add_project_root(r4)
    r4.add_argument("blocks", help="comma-separated block names, e.g. rv_core0,rv_core1")
    r4.add_argument("--feedback", default="",
                    help="revision text (default: each block's human constraint-ledger rules)")
    r4.set_defaults(func=_run_revise_blocks)

    # architecture (PRD/SAD/FRD/ERS/block_diagram). Use BEFORE `run start`
    # when validation_dv needs an ERS to verify against.
    pa = sub.add_parser("architecture", help="architecture phase lifecycle")
    asub = pa.add_subparsers(dest="arch_cmd", required=True)
    a1 = asub.add_parser("start", help="start the architecture graph")
    _add_project_root(a1)
    a1.add_argument("--requirements-file", help="path to requirements.md")
    a1.add_argument("--requirements", help="inline requirements text")
    a1.add_argument("--target-clock-mhz", type=float, default=50.0)
    a1.add_argument("--pdk-config-path", default="")
    a1.add_argument("--max-rounds", type=int, default=3)
    a1.set_defaults(func=_arch_start)
    a2 = asub.add_parser("state", help="architecture state snapshot")
    _add_project_root(a2)
    a2.set_defaults(func=_arch_state)
    a3 = asub.add_parser("resume", help="resume from architecture interrupt")
    _add_project_root(a3)
    a3.add_argument(
        "--action", required=True,
        help="continue | retry | accept | feedback | abort",
    )
    a3.add_argument("--feedback", help="feedback text or JSON answers")
    a3.add_argument("--rationale", help="rationale logged to the run record")
    a3.set_defaults(func=_arch_resume)
    a4 = asub.add_parser("pause", help="cancel the architecture task")
    _add_project_root(a4)
    a4.set_defaults(func=_arch_pause)

    # backend (flat synthesis + chip_top gate-sim). Use AFTER the frontend
    # reaches pipeline_done; set CORESMITH_AUTO_BACKEND=1 on the daemon to have
    # it make this call itself.
    pb = sub.add_parser("backend", help="backend lifecycle (flat synth + gate-sim)")
    bsub = pb.add_subparsers(dest="backend_cmd", required=True)
    b1 = bsub.add_parser("start", help="flat top synthesis + chip_top gate-sim")
    _add_project_root(b1)
    b1.add_argument("--max-attempts", type=int, default=3)
    b1.add_argument("--target-clock-mhz", type=float, default=50.0)
    b1.add_argument("--full", action="store_true",
                    help="continue into P&R/DRC/LVS after the gate-sim verdict "
                         "(default: stop at the verdict -- P&R is hours of EDA)")
    b1.set_defaults(func=_backend_start)
    b2 = bsub.add_parser("state", help="backend state + chip_top gate-sim verdict")
    _add_project_root(b2)
    b2.set_defaults(func=_backend_state)
    b3 = bsub.add_parser("pause", help="cancel the backend task")
    _add_project_root(b3)
    b3.set_defaults(func=_backend_pause)
    b4 = bsub.add_parser("resume", help="answer a parked backend interrupt (human_intervention_needed)")
    _add_project_root(b4)
    b4.add_argument("--action", required=True, help="retry | skip | abort | accept (see the park's supported_actions)")
    b4.add_argument("--feedback", help="constraint for the retry / rationale of an accept waiver")
    b4.add_argument("--rationale", help="rationale logged to the run record")
    b4.add_argument("--interrupt-id", help="the backend park's interrupt_id (`coresmith backend state`)")
    b4.add_argument("--actor", help="who answers (decisions / interrupts.resolved_by); default $CORESMITH_ROLE, else cli")
    b4.set_defaults(func=_backend_resume)

    # build: one recorded module build (the existing block subgraph on a
    # persistent checkpoint, one thread per build) and the builds ledger.
    pbu = sub.add_parser("build", help="recorded module builds: module | targets | status | resume | pause | abort | list | show | compare | lineage")
    busub = pbu.add_subparsers(dest="build_cmd", required=True)
    _json_help = "machine-readable output (refusals and failures included; exit 2 refused/invalid, 3 infrastructure)"
    bm = busub.add_parser(
        "module", help="build one module against its registered FRD targets (refused unless the module is ready)",
        description="Record the module's FRD target allocation and fixed inputs, then run DV, "
                    "coverage closure and required target checks.")
    _add_project_root(bm)
    bm.add_argument("module")
    bm.add_argument("--seed-rtl", default="", help="explicit reuse/import: an existing source of the bound target used "
                    "as the starting implementation (default: the worker implements the RTL from the spec, targets and "
                    "acceptance tests)")
    bm.add_argument("--max-attempts", type=int, default=3,
                    help="implementation attempts per build (default 3; 1 = no retry): a target miss, a failed "
                         "simulation or synthesis goes back to the worker until they are used up")
    bm.add_argument("--target-clock-mhz", type=float, default=None)
    bm.add_argument("--uarch-feedback", default="", help=argparse.SUPPRESS)
    bm.add_argument("--json", action="store_true", help=_json_help)
    bm.set_defaults(func=_build_module)
    bt = busub.add_parser("targets", help="the FRD target allocation a build of the module binds (read-only): required/"
                                          "advisory targets, measurement bindings, acceptance testbench, refusals")
    _add_project_root(bt)
    bt.add_argument("module")
    bt.add_argument("--json", action="store_true", help="machine-readable output (exit 2 when a build would be refused)")
    bt.set_defaults(func=_build_targets)
    bs = busub.add_parser("status", help="the durable build record + its live parks")
    _add_project_root(bs)
    bs.add_argument("--build-id", default="", help="default: the latest recorded build")
    bs.add_argument("--json", action="store_true", help=_json_help)
    bs.set_defaults(func=_build_status)
    br = busub.add_parser("resume", help="answer a build's park using one of its supported_actions")
    _add_project_root(br)
    br.add_argument("--build-id", required=True)
    br.add_argument("--action", required=True)
    br.add_argument("--feedback")
    br.add_argument("--rtl-fix-description")
    br.add_argument("--rationale")
    br.add_argument("--interrupt-id")
    br.add_argument("--actor")
    br.add_argument("--json", action="store_true", help=_json_help)
    br.set_defaults(func=_build_resume)
    bp = busub.add_parser("pause", help="cancel the running build task (the build parks; resume continues it)")
    _add_project_root(bp)
    bp.add_argument("--json", action="store_true", help=_json_help)
    bp.set_defaults(func=_build_pause)
    ba = busub.add_parser("abort", help="mark a parked/stopped build aborted (history kept) so its module can be built again")
    _add_project_root(ba)
    ba.add_argument("--build-id", required=True)
    ba.add_argument("--reason", default="")
    ba.add_argument("--actor")
    ba.add_argument("--json", action="store_true", help=_json_help)
    ba.set_defaults(func=_build_abort)
    for name, fn, help_ in (("list", _build_list, "recorded builds (newest first)"),
                            ("show", _build_show, "one build: record, evidence rows, current-pass status"),
                            ("compare", _build_compare, "two builds side by side with provenance"),
                            ("lineage", _build_lineage, "machine-readable graph lineage per module (treatment validity)")):
        p = busub.add_parser(name, help=help_)
        _add_project_root(p)
        p.add_argument("--json", action="store_true", help="machine-readable output")
        if name == "list":
            p.add_argument("--module", default="")
            p.add_argument("--limit", type=int, default=50)
        elif name == "show":
            p.add_argument("build_id")
        elif name == "compare":
            p.add_argument("build_a")
            p.add_argument("build_b")
        else:
            p.add_argument("--module", default="")
        p.set_defaults(func=fn)

    # state
    s = sub.add_parser("state", help="print the current pipeline state")
    _add_project_root(s)
    s.set_defaults(func=_run_state)

    # resume
    rs = sub.add_parser("resume", help="resume from the current interrupt")
    _add_project_root(rs)
    rs.add_argument(
        "--action", required=True,
        help=(
            "approve | accept | retry | skip | abort | feedback | "
            "fix_rtl | fix_tb | revise"
        ),
    )
    rs.add_argument("--feedback", help="text feedback for the agent")
    rs.add_argument("--rtl-fix-description", help="describe the on-disk RTL/TB edit")
    rs.add_argument("--rationale", help="rationale logged to the run record")
    rs.add_argument(
        "--block-actions",
        help="JSON dict of {block_name: action} for per-block resume",
    )
    rs.add_argument(
        "--interrupt-id",
        help="answer ONE parked branch (id from `coresmith interrupts --pending` or the "
             "payload's interrupt_id); queued (202) while sibling branches still run",
    )
    rs.add_argument("--affected-blocks", help="comma-separated blocks a revise targets")
    rs.add_argument(
        "--actor",
        help="who answers (recorded in decisions / interrupts.resolved_by); default "
             "$CORESMITH_ROLE, else cli",
    )
    rs.set_defaults(func=_run_resume)

    # logs
    lg = sub.add_parser("logs", help="tail pipeline_events.jsonl")
    _add_project_root(lg)
    lg.add_argument("-n", "--tail", type=int, default=50)
    lg.set_defaults(func=_run_logs)

    # harness: verify-as-tool + read-only state queries (engine-owned; direct
    # in-process calls, no daemon HTTP). Deferred import so the daemon-only
    # subcommands above still work if the engine package can't be imported.
    try:
        from orchestrator.harness.cli import register_subcommands
        register_subcommands(sub)
    except Exception:  # noqa: BLE001
        pass

    # Role-scoped CLI (CORESMITH_ROLE=architect|worker|watchdog): enforced here,
    # before dispatch, so the daemon-lifecycle verbs above are covered too.
    _role = (os.environ.get("CORESMITH_ROLE") or "").strip().lower()
    if _role:
        try:
            from orchestrator.harness.cli import role_allows, role_refusal
        except Exception:  # noqa: BLE001 - engine not importable: fail closed
            print(f"ROLE_FORBIDDEN {_role}: role check unavailable "
                  "(orchestrator.harness.cli not importable)", file=sys.stderr)
            sys.exit(2)
        if not role_allows(_role, sys.argv[1:]):
            _msg = role_refusal(_role, sys.argv[1:])
            print(_msg, file=sys.stderr)
            try:   # the refusal lands in the actions log (rc 2, actor = the role)
                from orchestrator.harness.cli import record_role_refusal
                record_role_refusal(sys.argv[1:], _role, _msg)
            except Exception:  # noqa: BLE001
                pass
            sys.exit(2)

    args = ap.parse_args()
    if getattr(args, "cmd", "") not in ("daemon", "run", "resume", "backend", "build"):
        args.func(args)
        return
    # The daemon-client lifecycle verbs land in the `actions` log too (rc and
    # the error line as summary), like every harness verb.
    _rc, _summary = 0, "ok"
    try:
        args.func(args)
    except SystemExit as _exc:
        _code = _exc.code
        _rc = _code if isinstance(_code, int) else (0 if _code is None else 1)
        _summary = "" if isinstance(_code, int) or _code is None else str(_code).splitlines()[0]
        raise
    except BaseException as _exc:  # noqa: BLE001 - logged, then re-raised
        _rc, _summary = 1, f"{type(_exc).__name__}: {_exc}"
        raise
    finally:
        try:
            from orchestrator.harness.cli import record_cli_action
            record_cli_action(sys.argv[1:], _rc, _summary,
                              create=(getattr(args, "cmd", "") == "daemon"))
        except Exception:  # noqa: BLE001 - the audit log must never break a verb
            pass


if __name__ == "__main__":
    main()
