# coresmith ASIC Orchestrator Environment Variables
# ================================================
# Copy this file to .env and fill in your values.

# Anthropic API key. Used by the Claude CLI (`claude`) which the
# orchestrator shells out to for every LLM call. Either set this here
# or run `claude auth login` once interactively before starting the pipeline.
#
# Alternative for headless / CI: a long-lived OAuth token from
# `claude setup-token`, exported as CLAUDE_CODE_OAUTH_TOKEN. The
# Docker entrypoint (scripts/runpod_entrypoint.sh) accepts either.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Override the default model used by every agent. Accepts either a short
# name (opus-4.6, opus-4.5, sonnet-4.5, sonnet-4, haiku-3.5) or any full
# Claude CLI model ID. Empty/unset falls back to DEFAULT_MODEL in
# orchestrator/langchain/agents/coresmith_llm.py.
# CORESMITH_MODEL=opus-4.5

# Override the path to the claude CLI binary if it isn't on $PATH.
# CLAUDE_CLI_PATH=/usr/local/bin/claude

# Optional: use Codex CLI instead of Claude CLI for LLM calls.
# Defaults to gpt-5.6 for top-level agents when CORESMITH_LLM_PROVIDER=codex.
# CORESMITH_LLM_PROVIDER=codex
# CORESMITH_CODEX_MODEL=gpt-5.6
# CODEX_CLI_PATH=/usr/local/bin/codex
# CORESMITH_CODEX_SANDBOX=workspace-write


# Optional: use Kimi Code CLI instead of Claude CLI for LLM calls.
# Install with `npm install -g @moonshot-ai/kimi-code`, then run `kimi login`.
# OAuth state is stored under KIMI_CODE_HOME (default: ~/.kimi-code).
# CORESMITH_LLM_PROVIDER=kimi
# CORESMITH_KIMI_MODEL=kimi-code/k3
# KIMI_CLI_PATH=/usr/local/bin/kimi
# KIMI_CODE_HOME=/path/to/persistent/kimi-code-home
# CORESMITH_KIMI_WORKDIR=/path/to/project
#
# Headless API-key alternative (both variables are required by Kimi Code):
# KIMI_MODEL_NAME=kimi-for-coding
# KIMI_MODEL_API_KEY=

# Optional: override the config file path
# CORESMITH_CONFIG=/path/to/config.yaml

# Optional: PDK root for Sky130 standard cells
# PDK_ROOT=/path/to/pdk
