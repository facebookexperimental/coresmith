# =============================================================================
# Makefile -- coresmith ASIC Build System
# =============================================================================
# Thin wrapper around the LangGraph-orchestrated pipeline.
#
# All real EDA work (synthesis, sim, PnR, DRC, LVS, STA) is driven by the
# pipeline graphs in orchestrator/langgraph/, which generate per-block Yosys
# scripts, SDC files, OpenROAD Tcl, etc. on the fly into syn/output/<block>/
# and pnr/output/<block>/. There are no static syn/scripts/ or pnr/openlane/
# files in this repo; older releases shipped them but they are now generated.
#
# Targets:
#   make daemon      -- Start coresmithd in the foreground for the current
#                       project_root (use `bin/coresmith daemon start` to
#                       launch detached). The daemon serves HTTP; agents
#                       drive it via the `coresmith` CLI.
#   make mcp         -- Start the MCP server for interactive use with Claude CLI
#   make lint        -- Run Verilator lint on every generated rtl/**/*.v file
#   make test        -- Run the orchestrator unit tests
#   make preflight   -- Validate PDK + EDA tools are installed before a run
#   make clean       -- Remove all generated build artifacts
#
# There is no `make pipeline` headless auto-approver any more. coresmith is
# a daemon (orchestrator/daemon/server.py) driven by `bin/coresmith` and
# fed decisions by an outer agent (Claude on cron). See CLAUDE.md.
# =============================================================================

PROJECT_ROOT := $(shell pwd)
PDK_ROOT ?= $(PROJECT_ROOT)/.pdk
VENV ?= $(PROJECT_ROOT)/venv

# Resolve python: prefer the project venv, fall back to whatever is on PATH so
# users who installed via `scripts/install_toolchain.sh` (which creates the
# venv at orchestrator/.venv) or via `pip install -e .` globally still work.
ifeq ($(wildcard $(VENV)/bin/python),)
  ifneq ($(wildcard $(PROJECT_ROOT)/orchestrator/.venv/bin/python),)
    PYTHON := $(PROJECT_ROOT)/orchestrator/.venv/bin/python
  else
    PYTHON := python3
  endif
else
  PYTHON := $(VENV)/bin/python
endif

export PDK_ROOT

# RTL source files generated by the pipeline into rtl/<block>/<name>.v
RTL_ALL := $(shell find rtl -name '*.v' 2>/dev/null)

.PHONY: all daemon backend mcp tapeout lint test test-all traces preflight demo clean help

# Default target: print usage. Avoids a confusing "no rule" error for users
# who type `make` expecting something to happen.
all: help

help:
	@echo "coresmith ASIC Build System"
	@echo ""
	@echo "Primary entry points:"
	@echo "  make daemon     -- Run coresmithd in the foreground (HTTP daemon)"
	@echo "  make mcp        -- Start MCP server for interactive use with Claude CLI"
	@echo ""
	@echo "Driving a run (via the bin/coresmith CLI talking to coresmithd):"
	@echo "  bin/coresmith daemon start --project-root <dir>"
	@echo "  bin/coresmith run start [--blocks-file <path>]"
	@echo "  bin/coresmith state"
	@echo "  bin/coresmith resume --action approve|retry|skip|fix_rtl|fix_tb"
	@echo ""
	@echo "Utilities:"
	@echo "  make preflight  -- Check PDK + EDA toolchain readiness"
	@echo "  make demo       -- Run the pipeline on an 8-bit adder (validates a fresh install)"
	@echo "  make lint       -- Verilator lint on every generated rtl/**/*.v"
	@echo "  make test       -- Run unit tests"
	@echo "  make clean      -- Remove generated artifacts"

# =============================================================================
# Preflight: validate PDK + tools before burning time on a real run
# =============================================================================
preflight:
	@echo "=== Running preflight check ==="
	@$(PYTHON) -c "from orchestrator.langgraph.pipeline_helpers import preflight_check; \
import json, sys; \
r = preflight_check(['pipeline', 'backend']); \
print(json.dumps(r, indent=2)); \
sys.exit(0 if r['ok'] else 1)"

# =============================================================================
# Lint -- Verilator lint on every generated RTL file
# =============================================================================
lint:
	@echo "=== Running Verilator lint on $(words $(RTL_ALL)) RTL files ==="
	@if [ -z "$(RTL_ALL)" ]; then \
		echo "  No RTL files found under rtl/. Run 'make pipeline' first."; \
	fi
	@for f in $(RTL_ALL); do \
		echo "  Linting $$f..."; \
		verilator --lint-only -Wall -Wno-fatal -Wno-EOFNEWLINE $$f 2>&1 || true; \
	done
	@echo "=== Lint complete ==="

# =============================================================================
# LangGraph daemon
# =============================================================================
# Foreground daemon for the current $(PROJECT_ROOT). For real runs use
# `bin/coresmith daemon start --project-root <run_dir>` which spawns
# detached + writes a discovery file.
daemon:
	@echo "=== Starting coresmithd (foreground) for $(PROJECT_ROOT) ==="
	CORESMITH_PROJECT_ROOT=$(PROJECT_ROOT) $(PYTHON) -m orchestrator.daemon.server

# The backend and tapeout graphs do not have a headless CLI runner --
# they're driven through the MCP server's start_backend / start_tapeout
# tools. Run `make mcp` and invoke the tool from Claude CLI / Cursor.
backend tapeout:
	@echo ""
	@echo "  The $@ pipeline runs through the MCP server, not as a CLI."
	@echo "  In one terminal: make mcp"
	@echo "  Then from Claude CLI / Cursor, call the start_$@ MCP tool."
	@echo ""
	@false

mcp:
	@echo "=== Starting MCP server ==="
	$(PYTHON) -m orchestrator.mcp_server

# =============================================================================
# Demo -- run the pipeline on a tiny reference design (8-bit adder).
# Used both by humans validating a fresh install and by the nightly e2e CI.
# Uses CORESMITH_BLOCKS_FILE to swap in examples/adder8/blocks.yaml as the
# blocks: section of config.yaml without mutating the canonical config.
# =============================================================================
demo:
	@echo "=== coresmith demo: 8-bit adder end-to-end ==="
	@echo "  Launches coresmithd against this directory and starts a pipeline run."
	@echo "  After the daemon parks at an interrupt, use 'bin/coresmith state' and"
	@echo "  'bin/coresmith resume --action approve' to drive it. Or wire up the"
	@echo "  cron-Claude autochecker described in CLAUDE.md."
	@echo ""
	bin/coresmith daemon start --project-root $(PROJECT_ROOT)
	bin/coresmith run start \
	    --project-root $(PROJECT_ROOT) \
	    --blocks-file $(PROJECT_ROOT)/examples/adder8/blocks.yaml
	@echo ""
	@echo "=== Demo started. Watch with: bin/coresmith state --project-root $(PROJECT_ROOT) ==="

# =============================================================================
# Tests
# =============================================================================
test:
	$(PYTHON) -m pytest orchestrator/tests/ -v -m "not live_llm and not requires_nix and not e2e"

test-all:
	$(PYTHON) -m pytest orchestrator/tests/ -v

# =============================================================================
# Traces -- inspect OTel spans collected by the SqliteSpanExporter
# =============================================================================
traces:
	@if [ ! -f $(PROJECT_ROOT)/.coresmith/traces.db ]; then \
		echo "No trace DB at .coresmith/traces.db -- start a pipeline run via bin/coresmith first."; \
		exit 1; \
	fi
	@echo "Span counts by node name (last 200 spans):"
	@sqlite3 $(PROJECT_ROOT)/.coresmith/traces.db \
	    "SELECT name, COUNT(*) AS n FROM spans GROUP BY name ORDER BY n DESC LIMIT 200;"
	@echo
	@echo "Slowest 10 spans:"
	@sqlite3 -header -column $(PROJECT_ROOT)/.coresmith/traces.db \
	    "SELECT name, (end_time_ns - start_time_ns)/1e9 AS sec FROM spans ORDER BY sec DESC LIMIT 10;"
	@echo
	@echo "Open a SQL shell with: sqlite3 .coresmith/traces.db"

# =============================================================================
# Clean
# =============================================================================
clean:
	rm -rf sim_build/
	rm -rf syn/output/
	rm -rf pnr/output/
	rm -rf .coresmith/step_logs/
	@echo "Build artifacts cleaned (rtl/, tb/, arch/ preserved)"

distclean: clean
	rm -rf rtl/ tb/ arch/ verification/ .coresmith/
	@echo "Full distclean complete"
