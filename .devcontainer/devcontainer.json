{
    "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
    "name": "coresmith-dev",

    // Inverted base: stock Ubuntu 22.04 devcontainer image (FHS, glibc,
    // apt) + Nix layered via the official devcontainer feature. The
    // production runtime image at ghcr.io/facebookexperimental/coresmith
    // still uses the openlane2 nix-only base; we don't try to make that
    // image double as a devcontainer because the agent (sshd / vscode-
    // remote-server / GitHub Codespaces tunnel) assumes a Debian-style
    // FHS layout that the nix-only base doesn't provide. This way the
    // agent is happy out of the box AND we don't have to fork the EDA
    // toolchain install.
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "configureZshAsDefaultShell": false,
            "upgradePackages": false
        },
        // sshd feature -- installs openssh-server via apt-get on this
        // Ubuntu base, which Just Works (unlike the openlane2 nix base
        // where apt-get is absent and the feature install crashes).
        "ghcr.io/devcontainers/features/sshd:1": {
            "version": "latest"
        },
        // Nix via the determinate.systems multi-user installer. Adds
        // the openlane.cachix.org substituter so the OpenLane2 install
        // step in onCreateCommand below is a binary-cache pull (~10 min)
        // instead of a from-source build (hours).
        "ghcr.io/devcontainers/features/nix:1": {
            "version": "latest",
            "multiUser": true,
            "extraNixConfig": "experimental-features = nix-command flakes\nextra-substituters = https://openlane.cachix.org\nextra-trusted-public-keys = openlane.cachix.org-1:qqdwh+QMNGmZAuyeQJTH9ErW57OWSvdtuwfBKdS254E="
        },
        // Node for the Claude Code CLI install.
        "ghcr.io/devcontainers/features/node:1": {
            "version": "20"
        },
        // Python 3.11 to match the production image and orchestrator
        // pyproject.toml.
        "ghcr.io/devcontainers/features/python:1": {
            "version": "3.11",
            "installTools": false
        },
        "ghcr.io/devcontainers/features/git:1": {}
    },

    "remoteUser": "root",
    "containerUser": "root",

    "workspaceFolder": "/workspaces/coresmith",

    "containerEnv": {
        "CORESMITH_PROJECT_ROOT": "/workspaces/coresmith",
        "PYTHONUNBUFFERED": "1"
    },

    "remoteEnv": {
        "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
        "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
    },

    // onCreate (runs once, shown in the "Setting up your codespace"
    // log so users see progress during the heavy nix pull):
    //
    // 1. Install the Claude Code CLI.
    // 2. Install OpenLane2 via `nix profile install` -- the cachix
    //    substituter configured above turns this into a binary-cache
    //    pull so it lands in ~10 min.
    // 3. Pip-install the orchestrator in editable mode + cocotb.
    "onCreateCommand": "set -eux; npm install -g @anthropic-ai/claude-code 2>&1 | tail -3; nix profile install --accept-flake-config github:efabless/openlane2 2>&1 | tail -20; pip install --upgrade pip; if [ -f /workspaces/coresmith/requirements.txt ]; then pip install -r /workspaces/coresmith/requirements.txt; fi; pip install cocotb cocotb-bus; if [ -d /workspaces/coresmith/orchestrator ]; then pip install -e /workspaces/coresmith/orchestrator; fi",

    "postAttachCommand": "echo 'coresmith dev container ready. openlane --version && which yosys'",

    "forwardPorts": [8765],
    "portsAttributes": {
        "8765": {
            "label": "coresmith MCP HTTP",
            "onAutoForward": "silent"
        }
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "mshr-h.veriloghdl",
                "anthropic.claude-code"
            ]
        }
    }
}
